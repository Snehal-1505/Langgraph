# ==============================================================================
# ResearchLab AI - Environment Configuration
# ==============================================================================

# LLM Provider Configuration (Options: "ollama", "gemini", "groq", "mock")
LLM_PROVIDER=ollama

# Ollama Local Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Optional Cloud Providers (Leave blank to use Ollama or Mock)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Web Search Configuration (Options: "duckduckgo", "tavily", "mock")
SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=

# Database Configuration
DATABASE_URL=sqlite:///./data/research.db

# API & Security Settings
FRONTEND_ORIGIN=http://localhost:5173
REQUEST_TIMEOUT_SECONDS=20
MAX_CONTENT_LENGTH_BYTES=500000

# Research Workflow Limits
MAX_RESEARCH_ATTEMPTS=2
MAX_REPORT_REVISIONS=2
MAX_SOURCES_PER_TASK=5
DEFAULT_SEARCH_DEPTH=standard
